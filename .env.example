# --- Server ---------------------------------------------------------------
HOST=0.0.0.0
PORT=8787
LOG_LEVEL=info

# --- Provider source ------------------------------------------------------
# Absolute path to the stream-providers repo root (contains dist/ and urls.json).
# Defaults to the parent of this directory.
#PROVIDERS_ROOT=/path/to/stream-providers
DEFAULT_PROVIDER=vega

# --- Provider URL manifest ------------------------------------------------
# Where the provider bundles fetch `urls.json` (upstream base URLs). This is
# the single source of truth — every runtime reads URLS_MANIFEST_URL. When
# unset, the bundles fall back to the urls.json committed to this repo (GitHub
# raw). Point it at your own hosted copy (e.g. https://api.example.com/urls.json)
# for deployments that must not depend on GitHub.
URLS_MANIFEST_URL=https://raw.githubusercontent.com/harusharu/stream-providers/refs/heads/main/urls.json

# --- Node worker pool -----------------------------------------------------
# Number of Node sidecar worker processes. Defaults to CPU count.
#WORKER_COUNT=10
# Per-call timeout seen by the Rust gateway (ms). This is the hard cap on any
# provider call. Most resolutions finish in 2-10s, but slow hosters (WAF
# challenges, multi-hop redirects) can legitimately take 30-60s, so the cap
# must leave room for them or users see "no playable stream".
CALL_TIMEOUT_MS=75000
# Timeout wired to the provider's AbortSignal (ms). Must be below
# CALL_TIMEOUT_MS so the provider aborts cleanly (and the worker survives)
# instead of the gateway force-recycling it.
WORKER_TIMEOUT_MS=60000
# Per-provider timeout for /api/search-all (ms). Must not exceed
# WORKER_TIMEOUT_MS. Slow providers are cut from the aggregated response
# without stalling the search bar.
SEARCH_ALL_TIMEOUT_MS=20000

# --- Rate limiting --------------------------------------------------------
# Per-IP quota (requests/minute) and burst. Exempts /, /health, /providers.
RATE_LIMIT_PER_MIN=600
RATE_LIMIT_BURST=120

# --- Caching (TTL in seconds) ---------------------------------------------
CACHE_CATALOG_SECS=300
CACHE_SEARCH_SECS=60
CACHE_META_SECS=60
CACHE_EPISODES_SECS=300
CACHE_STREAM_SECS=30

# --- CORS / TLS -----------------------------------------------------------
# Comma-separated list of allowed origins. "*" allows all.
CORS_ORIGINS=*
# Point both at a cert/key pair to enable rustls TLS; leave unset for HTTP
# (terminate TLS at a proxy in production).
#TLS_CERT=/path/to/cert.pem
#TLS_KEY=/path/to/key.pem