{
  "name": "stream-api",
  "version": "1.0.0",
  "type": "module",
  "description": "Hono-based Node.js gateway for stream-providers. Runs on Netlify, Vercel, Cloudflare, or a plain Node server.",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "start": "node lib/adapters/node.ts"
  },
  "dependencies": {
    "axios": "1.19.0",
    "cheerio": "1.2.0",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^24.0.0",
    "typescript": "^5.3.0"
  }
}
