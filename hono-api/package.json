{
  "name": "stream-api",
  "version": "1.0.0",
  "type": "module",
  "description": "Hono-based Node.js gateway for stream-providers. Runs on Netlify, Vercel, Cloudflare, or a plain Node server.",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "start": "node lib/adapters/node.ts"
  },
  "dependencies": {
    "axios": "1.19.0",
    "cheerio": "1.2.0",
    "curl-cffi-node": "0.1.8",
    "hono": "^4.6.0"
  },
  "overrides": {
    "curl-cffi-node-darwin-arm64": "npm:@curl-cffi-node/darwin-arm64@0.1.8",
    "curl-cffi-node-darwin-x64": "npm:@curl-cffi-node/darwin-x64@0.1.8",
    "curl-cffi-node-linux-arm64-gnu": "npm:@curl-cffi-node/linux-arm64-gnu@0.1.8",
    "curl-cffi-node-linux-x64-gnu": "npm:@curl-cffi-node/linux-x64-gnu@0.1.8",
    "curl-cffi-node-win32-x64-msvc": "npm:@curl-cffi-node/win32-x64-msvc@0.1.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^24.0.0",
    "typescript": "^5.3.0"
  }
}
